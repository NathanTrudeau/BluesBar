<UserControl x:Class="BluesBar.Gambloo.Scenes.ChickenRunScene"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0A0F18">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Panel" Color="#101826"/>
        <SolidColorBrush x:Key="PanelAlt" Color="#0E1420"/>
        <SolidColorBrush x:Key="Stroke" Color="#1F2A3A"/>
        <SolidColorBrush x:Key="Accent" Color="#FFCA3A"/>
        <SolidColorBrush x:Key="Danger" Color="#E93F4B"/>
        <SolidColorBrush x:Key="Success" Color="#32D399"/>

        <Style TargetType="Button" x:Key="NeonButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#182437"/>
            <Setter Property="BorderBrush" Value="#243044"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#21304A"/>
                                <Setter Property="BorderBrush" Value="#3F8FFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#263654"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource NeonButton}">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="BorderBrush" Value="#4CAF50"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>

        <Style TargetType="Button" x:Key="AlertButton" BasedOn="{StaticResource NeonButton}">
            <Setter Property="Background" Value="#7A1F2F"/>
            <Setter Property="BorderBrush" Value="#E63946"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="2" CornerRadius="14" Padding="12" Margin="0,0,0,14">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Vertical" DockPanel.Dock="Left" Margin="0,0,20,0">
                    <TextBlock Text="Chicken Run" FontFamily="Segoe UI Black" FontSize="20" Foreground="White"/>
                    <TextBlock x:Name="WalletText" Text="Wallet: 0" Foreground="#A0A9BA" FontSize="12"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" >
                    <StackPanel>
                        <TextBlock Text="Wager" Foreground="#ADB6C7" FontSize="11"/>
                        <TextBox x:Name="BetTextBox" Width="140" Height="34" Text="500" Padding="8,4" Background="#0B111D" Foreground="White" BorderBrush="{StaticResource Stroke}" BorderThickness="2" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Steps" Foreground="#ADB6C7" FontSize="11"/>
                        <ComboBox x:Name="StepCombo" Width="120" Height="34" SelectedIndex="0" SelectionChanged="StepCombo_SelectionChanged">
                            <ComboBoxItem Content="10 steps" Tag="10"/>
                            <ComboBoxItem Content="12 steps" Tag="12"/>
                            <ComboBoxItem Content="15 steps" Tag="15"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"  Margin="12,0,0,0">
                        <Button Content="+1K" Width="60" Style="{StaticResource NeonButton}" Click="BetPlusSmall_Click"/>
                        <Button Content="+10K" Width="70" Style="{StaticResource NeonButton}" Click="BetPlusLarge_Click"/>
                    </StackPanel>
                    <Button Content="START RUN" Width="140" Style="{StaticResource PrimaryButton}" Click="StartRun_Click" VerticalAlignment="Bottom"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- body -->
        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource Stroke}" BorderThickness="2" CornerRadius="14" Padding="12">
                <StackPanel>
                    <TextBlock Text="Road Map" Foreground="White" FontFamily="Segoe UI Black" FontSize="14" Margin="0,0,0,10"/>
                    <UniformGrid x:Name="StepGrid" Columns="5" Rows="3" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="2" CornerRadius="14" Padding="12">
                <StackPanel >
                    <StackPanel>
                        <TextBlock Text="Run stats" Foreground="#8EA1C3" FontSize="12"/>
                        <TextBlock x:Name="StepProgressText" Text="Step 0 / 10" Foreground="White" FontSize="16" FontFamily="Segoe UI Black"/>
                        <TextBlock x:Name="MultiplierText" Text="Multiplier: x1.0" Foreground="#FFD166" FontSize="14"/>
                        <TextBlock x:Name="HazardText" Text="Next risk: 0%" Foreground="#F4A261" FontSize="13"/>
                    </StackPanel>

                    <Border Background="#0B111D" BorderBrush="#1A2233" BorderThickness="1" CornerRadius="8" Padding="10">
                        <TextBlock TextWrapping="Wrap" Foreground="#AEB6C4" FontSize="12">
                            Cash out anytime to lock your winnings. Each step raises the multiplier by 0.1, and by 0.2 after step 7. The farther you go, the higher the odds of becoming grilled chicken.
                        </TextBlock>
                    </Border>

                    <StackPanel Orientation="Horizontal" >
                        <Button x:Name="AdvanceButton" Content="ADVANCE" Width="100" Style="{StaticResource PrimaryButton}" Click="Advance_Click"/>
                        <Button x:Name="CashOutButton" Content="CASH OUT" Width="100" Style="{StaticResource NeonButton}" Click="CashOut_Click"/>
                        <Button x:Name="ResetButton" Content="RESET" Width="80" Style="{StaticResource AlertButton}" Click="Reset_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="2" CornerRadius="14" Padding="10" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Text="" Foreground="White" FontSize="13"/>
        </Border>
    </Grid>
</UserControl>
